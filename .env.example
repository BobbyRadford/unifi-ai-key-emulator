# Required network and identity settings.
AIKEY_NVR=192.168.1.10
AIKEY_MAC=28704E000001
AIKEY_IP=192.168.1.50
AIKEY_DB_PASSWORD=change-me

# One-time adoption token from Protect; clear this after adoption completes.
AIKEY_ADOPTION_TOKEN=

# CPU threading and Whisper model size (used when Whisper runs on CPU).
AIKEY_THREADS=4
AIKEY_WHISPER=small

# Granular per-model backend selection: auto | cpu | hailo.
# "auto" uses Hailo-10H when /dev/hailo0 and the model's HEF exist in data/hailo/,
# and falls back to CPU otherwise.
AIKEY_CLIP_BACKEND=auto
AIKEY_REID_BACKEND=auto
AIKEY_WHISPER_BACKEND=auto

# Optional HEF filename override in data/hailo/ for person re-ID
# (default: osnet_x1_0.hef; repvgg_a0_person_reid_512.hef also works).
AIKEY_REID_HEF=
